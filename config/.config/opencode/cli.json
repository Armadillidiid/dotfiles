{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "opencode"
  },
  "keybinds": {
    "session.message.next": "<leader>]",
    "session.message.previous": "<leader>["
  },
  "diffs": {
    "wrap": "word",
    "tree": true
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "hide"
  },
  "animations": true
}
